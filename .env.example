# ── Server / API ─────────────────────────────────────────────────────────────
# MongoDB connection string (local dev or MongoDB Atlas free cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/learnhub

# Secret used to sign JWT auth tokens — change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Where the React dev server runs (used for CORS in local development)
CLIENT_URL=http://localhost:5173

# Port for the Express API in local development
PORT=5000

# Seed demo users/courses even if the database already has data
SEED_FORCE=false
